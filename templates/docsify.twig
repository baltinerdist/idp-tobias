<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Amtgard IDP - Developer Documentation</title>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <meta name="description" content="Amtgard Identity Provider API, league/oauth2-client integration, and amtgard-idp-client documentation.">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
  
  <!-- Premium Theme and Font -->
  <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/docsify@4/lib/themes/vue.css">
  <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/docsify-tabs@1/dist/themes/classic.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --theme-color: #5c6bc0;
      --theme-color-dark: #3f51b5;
      --docsifytabs-border-color: #eaeaea;
      --docsifytabs-tab-background: #fafafa;
      --docsifytabs-tab-background--active: #ffffff;
      --docsifytabs-tab-color--active: var(--theme-color);
      --docsifytabs-tab-highlight-color: var(--theme-color);
    }
    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      background-color: #fafafa;
    }
    .markdown-section {
      max-width: 850px;
    }
    code, kbd, pre, samp {
      font-family: 'JetBrains Mono', Consolas, Monaco, monospace;
    }
    .markdown-section pre>code {
      font-size: 0.9rem;
      border-radius: 6px;
    }
    .sidebar {
      background-color: #ffffff;
      border-right: 1px solid #eaeaea;
    }
    .sidebar-nav li a {
      font-weight: 500;
    }
    .app-name {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--theme-color);
    }
  </style>
</head>
<body>
  <div id="app">Loading Amtgard IDP Documentation...</div>
  <script>
    window.$docsify = {
      name: 'Amtgard IDP',
      basePath: '/docs/',
      homepage: 'readme.md',
      themeColor: '#5c6bc0',
      auto2top: true,
      executeScript: true,
      loadSidebar: false,
      maxLevel: 4,
      subMaxLevel: 3,
      tabs: {
        persist: true,      // Store active tab selection in local storage
        sync: true,         // Sync tabs with identical labels
        theme: 'classic',   // Tab theme
        tabComments: true,  // Use standard html comments
        tabHeadings: true   // Use headings as tab names
      }
    }
  </script>
  <!-- Docsify v4 -->
  <script src="//cdn.jsdelivr.net/npm/docsify@4"></script>
  <script src="//cdn.jsdelivr.net/npm/docsify-tabs@1"></script>
</body>
</html>
