# Application settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:37080
APP_SECRET=change_this_to_a_random_string

# Database settings
DB_DRIVER=pdo_mysql
DB_HOST=amtgard-idp-db
DB_PORT=3306
DB_NAME=idp
DB_USER=idp
DB_PASS=secret

REDIS_PUBLISHER_NAME=amtgard-idp

JWT_KEY=jwt_key
AUTH_SERVER_DEFUSE_KEY=auth_server_defust_key

# OAuth settings
OAUTH_PRIVATE_KEY=/var/www/idp.amtgard.com/dev-keys/private.key
OAUTH_PUBLIC_KEY=/var/www/idp.amtgard.com/dev-keys/public.key
OAUTH_ENCRYPTION_KEY=change_this_to_a_random_string
OAUTH_AUTH_TOKEN_TTL=PT10M
OAUTH_ACCESS_TOKEN_TTL=PT2H
OAUTH_REFRESH_TOKEN_TTL=P1M

# Google OAuth settings
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:37080/auth/google/callback

# Facebook OAuth settings
FACEBOOK_CLIENT_ID=facebook_client_id
FACEBOOK_CLIENT_SECRET=facebook_client_secret
FACEBOOK_REDIRECT_URI=http://localhost:37080/auth/facebook/callback

# Discord OAuth settings
DISCORD_CLIENT_ID=discord_client_id
DISCORD_CLIENT_SECRET=discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:37080/auth/discord/callback

MANAGEMENT_KEY=MANAGEMENTKEY
# ORK Service settings
ORK_API_USER_AGENT="bogus_user_agent"
ORK_API_REFERER="bogus_referer"

# Shared HS256 secret with ORK3 for /auth/connect handoff JWT verification,
# the completion-token signing, and the /resources/link-ork-profile mirror
# endpoint. Must match ORK's IDP_ORK_SHARED_SECRET byte-for-byte.
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
#
# The legacy name ORK_LINK_TOKEN_SECRET is still read as a fallback during
# the rename transition; new deploys should set IDP_ORK_SHARED_SECRET only.
IDP_ORK_SHARED_SECRET=

# Where the IDP redirects users back to after a successful /auth/connect flow.
ORK_BASE_URL=http://localhost:19080/orkui/

# Comma-separated client_ids allowed to call POST /resources/link-ork-profile.
# Should be only the ORK confidential client(s).
LINK_ORK_PROFILE_ALLOWED_CLIENT_IDS=
